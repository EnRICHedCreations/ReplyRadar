# Web + worker. Set APP URL to the verified Deploy Hatch web URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy anon key accepted if publishable key is absent.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only; Supabase connection string from Connect > Session pooler. URL-encode password.
DATABASE_URL=
# Optional CA PEM for a custom database CA. TLS verification stays enabled.
DATABASE_CA_CERT=
# Redis required for request rate limiting; use rediss:// for hosted TLS.
REDIS_URL=
SOCIAL_PROVIDER=mock
X_BEARER_TOKEN=
# Generate once: openssl rand -hex 32. Use identical value on web and worker.
INTEGRATION_ENCRYPTION_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Generate: openssl rand -hex 32; use it in Telegram setWebhook secret_token.
TELEGRAM_WEBHOOK_SECRET=
RESEND_API_KEY=
EMAIL_FROM=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_GROWTH=
# Server-side optional admin allowlist of Supabase user UUIDs.
ADMIN_USER_IDS=
# Not required: auth uses publishable key, worker uses DATABASE_URL.
SUPABASE_SERVICE_ROLE_KEY=
